# Copy to .env for local dev, and set these same keys in Netlify's
# dashboard (Site settings → Environment variables) for production.

# Postgres connection string from Neon (or Supabase).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Admin login. Use strong values in production.
ADMIN_PASSWORD="change-me-to-a-strong-password"
AUTH_SECRET="change-me-to-a-long-random-string"
